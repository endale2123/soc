# Server Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL 14+ Connection Settings
# Option A: Connection URI
DATABASE_URL=postgresql://soc_app:change_me@localhost:5432/mor_soc
# Option B: Discrete connection parameters (used if DATABASE_URL is unset)
PGHOST=localhost
PGPORT=5432
PGUSER=soc_app
PGPASSWORD=change_me
PGDATABASE=mor_soc
PGSSL=false

# Embedded PGlite fallback (for isolated local dev/testing without external Postgres)
USE_PGLITE=false
PGLITE_DATA_DIR=./.pglite-data

# Session & Security Settings
SESSION_SECRET=replace-with-at-least-32-chars-random-secret
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Agent Monitoring Thresholds
DEFAULT_HEARTBEAT_INTERVAL_SEC=30
DEFAULT_OFFLINE_THRESHOLD_SEC=120
EVENT_RETENTION_DAYS=180

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20
AGENT_INGEST_RATE_LIMIT_MAX=600

# Initial Bootstrap Admin (used only by seed when users table is empty)
BOOTSTRAP_ADMIN_EMAIL=endale.a@revenue.gov.et
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!SocAdmin2026
